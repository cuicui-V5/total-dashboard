# TotalDashboard Environment Variables Example
PORT=3344
NODE_ENV=production

# Glances Common Auth
GLANCES_USERNAME=your_username
GLANCES_PASSWORD=your_password

# Glances Nodes (Format: ID|LABEL|URL|TAG)
GLANCES_NODES=pve-ubuntu|PVE Ubuntu|http://192.168.2.250:61208|LAN,oracle1|甲骨文 1|http://oracle1.example.com:61208|Cloud,oracle2|甲骨文 2|http://oracle2.example.com:61208|Cloud,bwh|搬瓦工 DC9|http://bwh.example.com:61208|VPS,chuanjiabao|搬瓦工 传家宝|http://chuanjiabao.example.com:61208|VPS

# Uptime Kuma Configuration
UPTIME_KUMA_URL=http://192.168.2.250:3001
UPTIME_KUMA_API_KEY=uk1_your_api_key_here

# BandwagonHost (KiwiVM) API Configurations
# Format: ID|LABEL|VEID|API_KEY
BWH_INSTANCES=bwh1|搬瓦工 DC9 CN2GIA|1323594|private_your_api_key_1,bwh2|搬瓦工 传家宝|1946349|private_your_api_key_2
